# GEMINI_API_KEY: Required for Gemini AI API calls (Server-only).
GEMINI_API_KEY="your-gemini-api-key"

# APP_URL: Base URL where this applet is hosted.
APP_URL="https://your-applet-url.com"

# SUPABASE INTEGRATION (Database & Storage)
# NEXT_PUBLIC_SUPABASE_URL: Public URL of your Supabase project instance
NEXT_PUBLIC_SUPABASE_URL="https://your-supabase-project.supabase.co"

# NEXT_PUBLIC_SUPABASE_ANON_KEY: Public anonymous API key for client-side queries
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# SUPABASE_SERVICE_ROLE_KEY: Private administrative key for server-side database operations (SERVER-ONLY secret)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# PUBLIC STOREFRONT & BRAND CONFIGURATION
# NEXT_PUBLIC_WHATSAPP_NUMBER: Public business WhatsApp contact number (international format without +)
NEXT_PUBLIC_WHATSAPP_NUMBER="918233703080"

# NEXT_PUBLIC_GA_MEASUREMENT_ID: Optional public Google Analytics 4 Measurement ID (e.g., G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-RVWS18GCR"

# NEXT_PUBLIC_SITE_URL: Canonical public website domain URL used for SEO & sitemap generation
NEXT_PUBLIC_SITE_URL="https://muskydose.in"

# ADMIN AUTHENTICATION & SECURITY CREDENTIALS
# ADMIN_EMAIL: Primary administrative account login email address
ADMIN_EMAIL="admin@muskydose.in"

# ADMIN_PASSWORD: Secure password for primary admin panel authentication
ADMIN_PASSWORD="your-secure-admin-password"

# ADMIN_SESSION_SECRET: 32+ character random secret key for HMAC signature of admin session tokens (SERVER-ONLY)
ADMIN_SESSION_SECRET="your-32-char-random-hmac-secret-key"

# ADMIN_RECOVERY_MOBILE: Authorized mobile number for emergency admin password recovery OTP (SERVER-ONLY)
# WARNING: MUST NEVER BE EXPOSED VIA NEXT_PUBLIC VARIABLE. MUST REMAIN STRICTLY SERVER-SIDE.
ADMIN_RECOVERY_MOBILE="918233703080"

# OPTIONAL SMS OTP GATEWAY CREDENTIALS (Required ONLY for real SMS OTP delivery)
# Optional — when omitted, system safely handles OTP requests by returning PROVIDER_REQUIRED status.
# Do NOT uncomment or define unless you are connecting a live SMS gateway provider.
# SMS_GATEWAY_API_KEY="your-sms-gateway-api-key"
# SMS_SENDER_ID="MSKDOS"
# SMS_TEMPLATE_ID="your-dlt-template-id"

# GOOGLE ADS KEYWORD PLANNER INTEGRATION CREDENTIALS (Growth system - Disabled by default)
# Optional — required ONLY when actively enabling Google Ads integration.
# GOOGLE_ADS_ENABLED="false"
# GOOGLE_ADS_CLIENT_ID="your-google-ads-client-id"
# GOOGLE_ADS_CLIENT_SECRET="your-google-ads-client-secret"
# GOOGLE_ADS_DEVELOPER_TOKEN="your-google-ads-developer-token"
# GOOGLE_ADS_REFRESH_TOKEN="your-google-ads-refresh-token"
# GOOGLE_ADS_CUSTOMER_ID="your-google-ads-customer-id"
# GOOGLE_ADS_LOGIN_CUSTOMER_ID="your-google-ads-login-customer-id"
